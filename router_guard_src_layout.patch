+def enforce_router_starvation_guard(
+    path_probabilities: Sequence[float],
+    *,
+    step: int,
+    config: RouterStarvationGuardConfig,
+    path_names: Optional[Sequence[str]] = None,
+) -> Dict[str, Any]:
+    """Abort if the empirical finite-horizon router survival contract is violated.
+
+    The statistic is mean routing probability per path over the current batch and
+    sequence.  The guard is abort-only: it never clamps, rebalances, or changes
+    gradients.
+    """
+    t = int(step)
+    if t < 0:
+        raise ValueError("step must be non-negative")
+    if config.num_paths < 2:
+        raise ValueError("num_paths must be >= 2")
+    if config.discovery_horizon < 0:
+        raise ValueError("discovery_horizon must be non-negative")
+    p_min = _finite("minimum_probability", config.minimum_probability)
+    if not 0.0 < p_min < 1.0:
+        raise ValueError("minimum_probability must lie in (0, 1)")
+
+    probs = [_finite(f"path_probability[{i}]", p) for i, p in enumerate(path_probabilities)]
+    if len(probs) != config.num_paths:
+        raise ValueError(f"expected {config.num_paths} path probabilities, got {len(probs)}")
+    if any(p < 0.0 or p > 1.0 for p in probs):
+        raise ValueError("path probabilities must lie in [0, 1]")
+    if abs(sum(probs) - 1.0) > 1.0e-4:
+        raise ValueError(f"path probabilities must sum to 1 (got {sum(probs):.9g})")
+
+    names = list(path_names) if path_names is not None else [f"path_{i}" for i in range(config.num_paths)]
+    if len(names) != config.num_paths:
+        raise ValueError("path_names length must match num_paths")
+
+    if t > config.discovery_horizon:
+        return {
+            "active": False,
+            "step": t,
+            "bound": None,
+            "minimum_probability": p_min,
+            "path_probabilities": dict(zip(names, probs)),
+        }
+
+    bound = router_probability_floor(
+        config.num_paths,
+        config.initial_adverse_gap,
+        config.max_adverse_gap_drift_per_step,
+        t,
+    )
+    violations = []
+    for name, probability in zip(names, probs):
+        reasons = []
+        if probability + 1.0e-12 < bound:
+            reasons.append(f"below_dynamic_bound={bound:.9g}")
+        if probability + 1.0e-12 < p_min:
+            reasons.append(f"below_p_min={p_min:.9g}")
+        if reasons:
+            violations.append((name, probability, reasons))
+
+    if violations:
+        detail = "; ".join(
+            f"{name}: p={probability:.9g} ({', '.join(reasons)})"
+            for name, probability, reasons in violations
+        )
+        raise RouterStarvationError(
+            "router starvation guard aborted training at "
+            f"step {t}/{config.discovery_horizon}: {detail}"
+        )
+
+    return {
+        "active": True,
+        "step": t,
+        "bound": bound,
+        "minimum_probability": p_min,
+        "path_probabilities": dict(zip(names, probs)),
+    }
